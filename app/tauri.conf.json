{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Dispatch",
  "version": "1.0.0",
  "identifier": "dev.dispatch.reader",
  "build": {
    "frontendDist": "ui"
  },
  "app": {
    "withGlobalTauri": true,
    "macOSPrivateApi": true,
    "windows": [
      {
        "label": "main",
        "title": "Dispatch",
        "url": "index.html",
        "width": 1180,
        "height": 760,
        "minWidth": 640,
        "minHeight": 420,
        "visible": false,
        "center": true,
        "transparent": true,
        "windowEffects": { "effects": ["underWindowBackground"], "state": "active" }
      }
    ],
    "security": {
      "csp": "default-src 'self'; img-src 'self' data:; style-src 'self' 'unsafe-inline'; script-src 'self'; font-src 'self' data:"
    }
  },
  "bundle": {
    "active": true,
    "targets": ["app", "dmg"],
    "category": "News",
    "copyright": "MIT",
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.png"
    ],
    "macOS": {
      "minimumSystemVersion": "13.0",
      "signingIdentity": "-"
    }
  }
}
